# 本文件可进 Git。复制为 .env 后在本机填写密钥，不要提交 .env。
# 中文电脑和日文电脑各自保留一份 .env，不要互相覆盖。

# 应用
# Modified by DingJiaye: 2026-08-26 — 与页面品牌保持一致。
APP_NAME=信息系统与风险预测
DATABASE_URL=sqlite:///./data/risk_intel.db
SECRET_KEY=change-me-in-production

# 秘塔 AI 搜索 API（官方文档: https://metaso.cn/search-api/playground）
MITA_API_BASE_URL=https://metaso.cn/api/v1
MITA_API_KEY=mk-your_metaso_api_key

# DeepSeek API（新闻汇总、页面翻译、国际评级；同一密钥可换模型名）
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Gemini API（同一密钥按任务换模型）
# 密钥获取：https://aistudio.google.com/apikey
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
# 未填写时回退到 GEMINI_MODEL
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_STRONG_MODEL=gemini-3-flash-preview

# 主体评估：默认禁用 Mock；主体/信源目录和预警观察期
ENTITY_DEMO_MODE=false
ENTITY_TARGETS_CONFIG_PATH=config/entity_targets.yaml
ENTITY_WARNING_LOOKBACK_DAYS=90

# 外部新闻通知（至少配置一种渠道；不要把真实密码提交到 Git）
# 邮件：SMTP 账户、应用专用密码与收件人（多个收件人用逗号分隔）
ALERT_EMAIL_TO=risk-team@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=risk-intel@example.com
SMTP_USE_STARTTLS=true
# 企业微信群机器人 Webhook
WECOM_WEBHOOK_URL=

# 深度研报正式生成模式。升级默认 legacy；切换后需重启应用。
INDUSTRY_REPORT_GENERATION_MODE=legacy
# 现场演示：航空、能源/电力生成固定样稿；正式使用前改为 false。
INDUSTRY_DEMO_FIXED_REPORTS=true
GROUNDED_REPORT_REQUIRE_APPROVAL=true
# 安全策略固定关闭：grounded 失败不会静默调用 legacy Prompt。
GROUNDED_REPORT_ALLOW_LEGACY_FALLBACK=false

# 调度（cron 表达式，默认每天 06:00；按服务器时区调整）
DAILY_PIPELINE_CRON=0 6 * * *
# 国际评级／市场信号自动更新（东京时区）
INTL_RATINGS_REFRESH_CRON=30 6 * * *

# 近 N 小时资讯窗口（点击「开始运行」采集范围）
NEWS_WINDOW_HOURS=24
# 是否抓取正文（关=更快；开=摘要更准但明显变慢）
NEWS_FETCH_BODY=true
NEWS_MAX_BODY_ITEMS=8
# 页面无新闻时是否自动启动采集。默认关闭，已保存新闻会直接从本地 SQLite 读取。
NEWS_AUTO_BACKFILL_ON_EMPTY=false

# 外网偶发 DNS/超时自动重试（提高一次采集成功率）
NETWORK_RETRY_ATTEMPTS=2
NETWORK_RETRY_BACKOFF_SECONDS=1.2

# 流水线韧性与加速
PIPELINE_ASYNC_DEFAULT=true
# LLM 单批条数（非展示上限；展示不设上限）
PIPELINE_LLM_TOP_K=12
PIPELINE_LLM_CACHE_HOURS=168
# 同一模块内 LLM 分批并发（建议 2～3；1=串行）
PIPELINE_LLM_CONCURRENCY=3
PIPELINE_MITA_QUERY_PAUSE_SECONDS=0.3
# 秘塔不足才补：主源有效候选 ≥ 此值则跳过；0 = 默认 24
PIPELINE_MITA_MIN_ITEMS=0
# 主源硬故障（RSS 全挂 / 模块 C 的 TDnet API 失败）时强制补秘塔
PIPELINE_MITA_FORCE_ON_PRIMARY_FAIL=true
# 秘塔空结果后，对模块 C 和日本主体用 DuckDuckGo 新闻补缺（仅 duckduckgo 后端）
SEARCH_DDG_FALLBACK_ENABLED=false
SEARCH_DDG_REGION=jp-jp
# 新闻检索固定使用秘塔；不回退 Gemini/DeepSeek 联网搜索
SEARCH_LLM_FALLBACK_ENABLED=false
# 风险情报智能体：DeepSeek 仅规划查询；新闻事实仍取自抓取到的正文和可核验来源。
INTELLIGENCE_AGENT_ENABLED=true
INTELLIGENCE_AGENT_PLAN_CACHE_HOURS=12
# Modified by DingJiaye: 2026-08-27 — AI 审核新闻归属；仅模型不可用时回退静态规则。
INTELLIGENCE_AGENT_AI_SCREENING_ENABLED=true
# Modified by DingJiaye: 2026-08-27 — 主题评估使用 AI 进行主体与关联方相关性审核。
INTELLIGENCE_AGENT_ENTITY_SCREENING_ENABLED=true
# B/C/D 模块并行（已开 WAL）。侧栏/上传明显变卡时改 false
PIPELINE_MODULE_PARALLEL=true
PIPELINE_MERGE_LLM=true
# 单模块内 RSS/Google 并发拉取数（1=串行）
PIPELINE_RSS_FETCH_WORKERS=6
# 同模块主源通道并行（RSS/直连/新浪/TDnet）
PIPELINE_CHANNEL_PARALLEL=true
# 单模块主源采集上限
PIPELINE_COLLECT_MAX_ITEMS=80
RSS_CONFIG_PATH=config/rss_feeds.yaml
DIRECT_SITES_CONFIG_PATH=config/direct_sites.yaml

# 国际评级（界面四）流水线
INTL_RATINGS_CONFIG_PATH=config/intl_ratings.yaml
OPENFIGI_API_KEY=
# TradingView（tvDatafeed，可选；不填则匿名模式）
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=
# SEC EDGAR 合规 User-Agent
SEC_EDGAR_COMPANY=RiskIntelSystem
SEC_EDGAR_EMAIL=risk-intel@example.com
